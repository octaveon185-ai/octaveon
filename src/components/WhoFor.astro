---
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].whoFor;
---

<section class="oo-who">
  <div class="oo-container oo-reveal oo-who__inner">
    <h2 class="oo-display oo-who__lead">{t.lead}</h2>
    <p class="oo-who__body">{t.body}</p>
    <div class="oo-who__divider" aria-hidden="true"></div>
    <p class="oo-who__closing">{t.closing}</p>
  </div>
</section>

<style>
  .oo-who {
    position: relative;
    padding: clamp(110px, 18vh, 210px) var(--oo-gutter);
    text-align: center;
    background: var(--oo-grad-dusk);
    color: var(--oo-text-on-dark);
    overflow: hidden;
  }
  .oo-who::before {
    content: none;
  }
  .oo-who__inner {
    position: relative;
    z-index: 1;
    max-width: 980px;
  }
  .oo-who__lead {
    margin: 0 auto;
    max-width: 900px;
    color: var(--oo-cream-100);
    font-size: clamp(45px, 6.5vw, 82px);
    line-height: 1.04;
    text-wrap: balance;
  }
  .oo-who__body {
    max-width: 720px;
    margin: 28px auto 0;
    color: rgba(234, 231, 227, .72);
    font-size: clamp(16px, 1.35vw, 19px);
    line-height: 1.8;
    text-wrap: pretty;
  }
  .oo-who__divider {
    width: 56px;
    height: 1px;
    margin: clamp(42px, 7vh, 72px) auto;
    background: linear-gradient(90deg, transparent, var(--oo-gold-light), transparent);
  }
  .oo-who__closing {
    max-width: 660px;
    margin: 0 auto;
    font-size: clamp(14px, 1.5vw, 18px);
    line-height: 1.7;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--oo-gold-light);
    text-wrap: balance;
  }

  @media (max-width: 600px) {
    .oo-who {
      padding-block: 100px;
    }
    .oo-who__lead {
      font-size: clamp(40px, 12vw, 54px);
      line-height: 1.06;
    }
    .oo-who__closing {
      font-size: 12px;
      letter-spacing: 0.1em;
    }
  }
</style>
