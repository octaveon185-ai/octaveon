---
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import { content, homeHref, type Lang } from '../i18n/content';
import { heroMedia } from '../config/site';
import { journalArticle, journalArticlePaths } from '../i18n/journalArticle';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = journalArticle[lang];
const siteContent = content[lang];
const canonical = new URL(journalArticlePaths[lang], Astro.site).toString();
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: t.title,
  description: t.seoDescription,
  image: new URL(heroMedia.poster.src, Astro.site).toString(),
  datePublished: t.publishedTime,
  dateModified: t.modifiedTime,
  inLanguage: lang,
  author: { '@type': 'Organization', name: t.author, url: Astro.site?.toString() },
  publisher: { '@type': 'Organization', name: 'Octave On', url: Astro.site?.toString() },
  mainEntityOfPage: canonical,
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Octave On', item: new URL(homeHref(lang), Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: siteContent.journal.title, item: canonical },
  ],
};
---

<Nav lang={lang} context="article" />
<main class="oo-article-page">
  <article class="oo-article" itemscope itemtype="https://schema.org/Article">
    <header class="oo-article__hero">
      <div class="oo-container oo-article__hero-inner">
        <nav class="oo-article__breadcrumbs" aria-label="Breadcrumb">
          <a href={homeHref(lang)}>Octave On</a>
          <span aria-hidden="true">/</span>
          <span>{siteContent.nav.links[3].label}</span>
        </nav>
        <p class="oo-eyebrow">{t.eyebrow}</p>
        <h1 class="oo-display" itemprop="headline">{t.title}</h1>
        <p class="oo-article__dek" itemprop="description">{t.intro}</p>
        <div class="oo-article__meta">
          <span>{t.author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={t.publishedTime} itemprop="datePublished">{t.publishedTime}</time>
          <span aria-hidden="true">·</span>
          <span>{t.readTime}</span>
        </div>
      </div>
    </header>

    <div class="oo-article__hero-media oo-container">
      <img src={heroMedia.poster.src} alt={t.heroAlt} width={heroMedia.poster.width} height={heroMedia.poster.height} fetchpriority="high" itemprop="image" />
    </div>

    <div class="oo-container oo-article__layout">
      <aside class="oo-article__toc" aria-label={lang === 'it' ? 'Indice dell’articolo' : lang === 'es' ? 'Índice del artículo' : 'Article contents'}>
        <p class="oo-eyebrow">{lang === 'it' ? 'IN QUESTO ARTICOLO' : lang === 'es' ? 'EN ESTE ARTÍCULO' : 'IN THIS ARTICLE'}</p>
        <ol>
          {t.sections.map((section) => <li><a href={`#${section.id}`}>{section.title}</a></li>)}
          <li><a href="#faq">{t.faqTitle}</a></li>
        </ol>
      </aside>

      <div class="oo-article__body" itemprop="articleBody">
        {t.sections.map((section) => (
          <section id={section.id} class="oo-article__section">
            <h2 class="oo-display">{section.title}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </section>
        ))}

        <section id="faq" class="oo-article__faq">
          <p class="oo-eyebrow">FAQ</p>
          <h2 class="oo-display">{t.faqTitle}</h2>
          <div class="oo-article__faq-list">
            {t.faq.map((item) => (
              <details>
                <summary>{item.question}<span aria-hidden="true">+</span></summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </section>

        <div class="oo-article__cta">
          <p>{lang === 'it' ? 'Vuoi vivere Octave On di persona?' : lang === 'es' ? '¿Quieres vivir Octave On en persona?' : 'Want to experience Octave On in person?'}</p>
          <a class="oo-btn oo-btn--primary" href={`${homeHref(lang)}${t.ctaHref}`}>{t.cta}</a>
        </div>
      </div>
    </div>
  </article>
</main>
<Footer lang={lang} context="article" />

<script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<style>
  .oo-article-page { background: var(--oo-night-800); }
  .oo-article { overflow: hidden; }
  .oo-article__hero {
    padding: clamp(130px, 17vh, 210px) var(--oo-gutter) clamp(60px, 9vh, 100px);
    background:
      radial-gradient(circle at 78% 28%, rgba(18, 65, 156, .32), transparent 36%),
      linear-gradient(180deg, var(--oo-night-950), var(--oo-night-800));
  }
  .oo-article__hero-inner { max-width: 920px; }
  .oo-article__breadcrumbs {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: clamp(48px, 7vh, 84px);
    color: var(--oo-slate);
    font-size: 12px;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .oo-article__breadcrumbs a { color: var(--oo-gold-light); }
  .oo-article__hero h1 {
    max-width: 900px;
    margin-top: 18px;
    color: var(--oo-cream-100);
    font-size: clamp(50px, 8vw, 104px);
    line-height: .92;
    text-wrap: balance;
  }
  .oo-article__dek {
    max-width: 740px;
    margin-top: 32px;
    color: var(--oo-cream-200);
    font-size: clamp(18px, 1.7vw, 24px);
    line-height: 1.55;
  }
  .oo-article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
    color: var(--oo-slate);
    font-size: 12px;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .oo-article__hero-media {
    margin-top: -1px;
    max-width: 1320px;
    padding-inline: var(--oo-gutter);
  }
  .oo-article__hero-media img {
    width: 100%;
    max-height: 620px;
    object-fit: cover;
    object-position: center;
    border: 1px solid rgba(230, 190, 102, .18);
    border-radius: var(--oo-radius);
    filter: saturate(.78) contrast(1.06) brightness(.86);
  }
  .oo-article__layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 760px);
    justify-content: space-between;
    gap: clamp(50px, 8vw, 120px);
    padding-block: clamp(70px, 10vh, 120px) clamp(100px, 14vh, 170px);
  }
  .oo-article__toc { align-self: start; position: sticky; top: 110px; }
  .oo-article__toc ol { list-style: none; margin-top: 18px; }
  .oo-article__toc li { border-top: 1px solid rgba(170, 181, 209, .15); }
  .oo-article__toc a {
    display: block;
    padding: 11px 0;
    color: var(--oo-slate);
    font-size: 13px;
    line-height: 1.35;
    transition: color .25s var(--oo-ease);
  }
  .oo-article__toc a:hover { color: var(--oo-gold-light); }
  .oo-article__section + .oo-article__section { margin-top: clamp(54px, 8vh, 90px); }
  .oo-article__section h2, .oo-article__faq h2 {
    color: var(--oo-cream-100);
    font-size: clamp(34px, 4vw, 54px);
    line-height: 1;
    text-wrap: balance;
  }
  .oo-article__section p {
    margin-top: 22px;
    color: var(--oo-cream-200);
    font-size: clamp(16px, 1.25vw, 19px);
    line-height: 1.78;
  }
  .oo-article__faq {
    margin-top: clamp(80px, 12vh, 140px);
    padding-top: clamp(50px, 7vh, 78px);
    border-top: 1px solid rgba(230, 190, 102, .22);
  }
  .oo-article__faq h2 { margin-top: 14px; }
  .oo-article__faq-list { margin-top: 32px; border-top: 1px solid rgba(170, 181, 209, .16); }
  .oo-article__faq details { border-bottom: 1px solid rgba(170, 181, 209, .16); }
  .oo-article__faq summary {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 20px 0;
    color: var(--oo-cream-100);
    cursor: pointer;
    font-size: 17px;
    font-weight: 500;
    list-style: none;
  }
  .oo-article__faq summary::-webkit-details-marker { display: none; }
  .oo-article__faq summary span { color: var(--oo-gold-light); font-size: 24px; font-weight: 300; }
  .oo-article__faq details[open] summary span { transform: rotate(45deg); }
  .oo-article__faq details p { max-width: 680px; padding: 0 42px 22px 0; color: var(--oo-slate); font-size: 15px; }
  .oo-article__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    margin-top: 76px;
    padding: 28px 0 0;
    border-top: 1px solid rgba(230, 190, 102, .22);
    color: var(--oo-cream-100);
    font-family: var(--oo-font-display);
    font-size: clamp(24px, 3vw, 36px);
    line-height: 1.1;
  }
  .oo-article__cta .oo-btn { flex: 0 0 auto; font-family: var(--oo-font-body); font-size: 12px; }
  @media (max-width: 800px) {
    .oo-article__layout { grid-template-columns: 1fr; gap: 44px; }
    .oo-article__toc { position: static; }
    .oo-article__toc ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 20px; }
    .oo-article__cta { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 500px) {
    .oo-article__toc ol { grid-template-columns: 1fr; }
    .oo-article__hero-media { padding-inline: 0; }
    .oo-article__hero-media img { border-radius: 0; border-inline: 0; }
  }
</style>
