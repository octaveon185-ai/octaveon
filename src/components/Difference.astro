---
import { content, type Lang } from '../i18n/content';
import { differenceVisual } from '../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].difference;
---

<section class="oo-diff">
  <div class="oo-container oo-reveal oo-diff__inner">
    <blockquote class="oo-diff__quote">
      <p class="oo-display">{t.quote}</p>
      <footer>— {t.author}</footer>
    </blockquote>
    <a class="oo-btn oo-btn--primary oo-diff__cta" href="#invito">{t.cta}</a>
    <figure class="oo-diff__visual">
      <picture>
        <source srcset={differenceVisual.srcSet} sizes="(max-width: 760px) 92vw, 72vw" type="image/webp" />
        <img src={differenceVisual.src} alt={t.visualAlt} width={differenceVisual.width} height={differenceVisual.height} loading="lazy" decoding="async" />
      </picture>
    </figure>
  </div>
</section>

<style>
  .oo-diff {
    position: relative;
    min-height: 0;
    padding: clamp(64px, 9vh, 104px) var(--oo-gutter);
    background: var(--oo-grad-night);
    overflow: hidden;
    display: grid;
    place-items: center;
    text-align: center;
  }
  .oo-diff::before {
    content: '“';
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -55%;
    font-family: var(--oo-font-display);
    font-size: clamp(190px, 27vw, 390px);
    line-height: 1;
    color: rgba(224, 174, 99, 0.035);
    pointer-events: none;
  }
  .oo-diff__inner {
    position: relative;
    z-index: 1;
    max-width: 1080px;
  }
  .oo-diff__quote {
    margin: 0 auto;
  }
  .oo-diff__quote p {
    margin: 0;
    font-size: clamp(30px, 4.1vw, 52px);
    line-height: 1.02;
    font-weight: 400;
    color: var(--oo-cream-100);
    text-wrap: balance;
  }
  .oo-diff__quote footer {
    margin-top: clamp(22px, 3vh, 34px);
    color: var(--oo-gold-light);
    font-size: clamp(12px, 1.2vw, 15px);
    font-style: normal;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .oo-diff__visual {
    width: min(100%, 920px);
    aspect-ratio: 3 / 2;
    margin: clamp(38px, 6vh, 64px) auto 0;
    overflow: hidden;
    border: 1px solid rgba(230, 190, 102, .22);
    border-radius: 18px;
    background: #01030f;
  }

  .oo-diff__cta {
    margin-top: clamp(28px, 4vh, 44px);
  }

  .oo-diff__visual picture,
  .oo-diff__visual img {
    width: 100%;
    height: 100%;
  }

  .oo-diff__visual img {
    object-fit: cover;
    object-position: center;
  }

  @media (max-width: 600px) {
    .oo-diff {
      min-height: 0;
      padding-block: 72px;
    }
    .oo-diff__quote p {
      font-size: clamp(29px, 9vw, 40px);
      line-height: 1.06;
    }
  }
</style>
