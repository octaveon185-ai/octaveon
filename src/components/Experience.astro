---
import { content, type Lang } from '../i18n/content';
import { experienceVisuals } from '../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].experience;
---

<section id="esperienza" class="oo-exp">
  <div class="oo-container">
    <header class="oo-reveal oo-exp__head">
      <p class="oo-eyebrow">A FIVE-PART JOURNEY</p>
      <h2 class="oo-display oo-exp__title">{t.title}</h2>
    </header>

    <ol class="oo-exp__list">
      {t.rituals.map((ritual, index) => {
        const visual = experienceVisuals[ritual.num as keyof typeof experienceVisuals];
        const flipped = index % 2 === 1;

        return (
          <li class="oo-reveal oo-exp__row" data-flip={flipped ? 'true' : 'false'}>
            <div class="oo-exp__visual" aria-label={visual.kind === 'graphic' ? visual.label : undefined}>
              {visual.kind === 'image' ? (
                <>
                  <img
                    src={visual.src}
                    alt={visual.alt}
                    width={visual.width}
                    height={visual.height}
                    loading="lazy"
                    decoding="async"
                  />
                  <a class="oo-exp__credit" href={visual.source} target="_blank" rel="noopener">
                    {visual.credit}
                  </a>
                </>
              ) : visual.kind === 'placeholder' ? (
                <div class="oo-exp__placeholder" aria-label={visual.label}>
                  <span class="oo-exp__placeholderHalo" aria-hidden="true"></span>
                  <span class="oo-exp__placeholderFigure" aria-hidden="true">
                    <i></i><b></b>
                  </span>
                  <small>ORIGINAL ASSET · PENDING</small>
                  <strong>{visual.composition}</strong>
                  <code>{visual.plannedSrc}</code>
                </div>
              ) : visual.variant === 'toroid' ? (
                <svg class="oo-exp__geometry oo-exp__geometry--toroid" viewBox="0 0 500 500" role="img" aria-label={visual.label}>
                  <g fill="none" stroke="currentColor">
                    {Array.from({ length: 14 }).map((_, i) => (
                      <ellipse cx="250" cy="250" rx={58 + i * 11} ry="198" transform={`rotate(${i * 12.85} 250 250)`} />
                    ))}
                    <circle cx="250" cy="250" r="199" />
                    <circle cx="250" cy="250" r="56" />
                  </g>
                </svg>
              ) : (
                <svg class="oo-exp__geometry oo-exp__geometry--circle" viewBox="0 0 500 500" role="img" aria-label={visual.label}>
                  <g fill="none" stroke="currentColor">
                    <circle cx="250" cy="250" r="58" />
                    <circle cx="250" cy="250" r="106" />
                    <circle cx="250" cy="250" r="156" />
                    <circle cx="250" cy="250" r="204" />
                    <path d="M48 250h404M250 48v404" opacity=".16" />
                  </g>
                  <circle cx="250" cy="250" r="5" fill="currentColor" />
                </svg>
              )}
            </div>

            <article class="oo-exp__body">
              <span class="oo-exp__num" aria-hidden="true">{ritual.num}</span>
              <h3 class="oo-display oo-exp__name">{ritual.name}</h3>
              <p class="oo-exp__sub">{ritual.sub}</p>
              <span class="oo-exp__rule" aria-hidden="true"></span>
              <p class="oo-exp__desc">{ritual.desc}</p>
            </article>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .oo-exp {
    position: relative;
    padding: clamp(90px, 13vh, 160px) var(--oo-gutter);
    color: var(--oo-text-on-dark);
    background:
      radial-gradient(circle at 10% 18%, rgba(18, 65, 156, .2), transparent 23%),
      linear-gradient(180deg, var(--oo-night-700), var(--oo-night-800));
    overflow: hidden;
  }

  .oo-exp__head {
    max-width: 720px;
    margin: 0 auto clamp(72px, 11vh, 130px);
    text-align: center;
  }

  .oo-exp__title {
    margin-top: 16px;
    color: var(--oo-cream-100);
    font-size: clamp(48px, 7vw, 86px);
  }

  .oo-exp__list {
    display: flex;
    flex-direction: column;
    gap: clamp(80px, 13vh, 154px);
    max-width: 1080px;
    margin: 0 auto;
    list-style: none;
  }

  .oo-exp__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, .92fr);
    align-items: center;
    gap: clamp(40px, 8vw, 110px);
  }

  .oo-exp__row[data-flip='true'] .oo-exp__visual { order: 2; }

  .oo-exp__visual {
    position: relative;
    min-width: 0;
    width: 100%;
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid rgba(230, 190, 102, .22);
    border-radius: 220px 220px 18px 18px;
    background:
      radial-gradient(circle at 50% 40%, rgba(28, 91, 196, .2), transparent 46%),
      rgba(1, 3, 19, .34);
    box-shadow: 0 34px 80px rgba(1, 3, 19, .24);
  }

  .oo-exp__visual::before {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(3, 8, 36, .06), transparent 50%, rgba(3, 8, 36, .78)),
      linear-gradient(90deg, rgba(3, 8, 36, .25), transparent 28%, transparent 72%, rgba(3, 8, 36, .25));
  }

  .oo-exp__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) sepia(.08) contrast(1.08);
    transition: transform 1.4s var(--oo-ease), filter 1.4s var(--oo-ease);
  }

  .oo-exp__row:hover .oo-exp__visual img {
    transform: scale(1.025);
    filter: grayscale(1) sepia(.1) contrast(1.13);
  }

  .oo-exp__credit {
    position: absolute;
    z-index: 2;
    left: 20px;
    bottom: 17px;
    max-width: calc(100% - 40px);
    color: rgba(234, 231, 227, .72);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: .15em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .oo-exp__placeholder {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    padding: 44px 28px;
    text-align: center;
    background:
      linear-gradient(rgba(230, 190, 102, .035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(230, 190, 102, .035) 1px, transparent 1px);
    background-size: 34px 34px;
  }

  .oo-exp__placeholderHalo {
    position: absolute;
    top: 12%;
    left: 50%;
    width: 64%;
    aspect-ratio: 1;
    translate: -50% 0;
    border: 1px solid rgba(230, 190, 102, .24);
    border-radius: 50%;
    box-shadow:
      0 0 0 38px rgba(230, 190, 102, .025),
      0 0 80px rgba(19, 75, 183, .2);
  }

  .oo-exp__placeholderFigure {
    position: absolute;
    top: 22%;
    left: 50%;
    width: 25%;
    height: 49%;
    translate: -50% 0;
    opacity: .5;
  }

  .oo-exp__placeholderFigure i,
  .oo-exp__placeholderFigure b {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    border: 1px solid rgba(230, 190, 102, .58);
  }

  .oo-exp__placeholderFigure i {
    top: 0;
    width: 40%;
    aspect-ratio: 1;
    border-radius: 50%;
  }

  .oo-exp__placeholderFigure b {
    top: 25%;
    width: 100%;
    height: 75%;
    border-radius: 50% 50% 20% 20%;
    clip-path: polygon(28% 0, 72% 0, 100% 100%, 0 100%);
  }

  .oo-exp__placeholder small {
    color: var(--oo-gold-light);
    font-size: 7px;
    font-weight: 700;
    letter-spacing: .2em;
  }

  .oo-exp__placeholder strong {
    color: rgba(234, 231, 227, .7);
    font-family: var(--oo-font-display);
    font-size: clamp(17px, 1.7vw, 22px);
    font-weight: 400;
    letter-spacing: .08em;
  }

  .oo-exp__placeholder code {
    color: rgba(170, 181, 209, .4);
    font-size: 7px;
  }

  .oo-exp__geometry {
    width: min(72%, 360px);
    height: auto;
    color: rgba(230, 190, 102, .58);
    filter: drop-shadow(0 0 24px rgba(198, 150, 61, .18));
  }

  .oo-exp__geometry g {
    stroke-width: 1.05;
  }

  .oo-exp__geometry--toroid {
    animation: geometryBreathe 12s ease-in-out infinite;
  }

  .oo-exp__body {
    position: relative;
    max-width: 490px;
  }

  .oo-exp__num {
    display: block;
    margin-bottom: 18px;
    color: var(--oo-gold-light);
    font-family: var(--oo-font-body);
    font-size: clamp(24px, 2.5vw, 32px);
    font-weight: 300;
    line-height: 1;
    letter-spacing: .08em;
  }

  .oo-exp__name {
    color: var(--oo-cream-100);
    font-size: clamp(35px, 4.2vw, 58px);
  }

  .oo-exp__sub {
    max-width: 38ch;
    margin-top: 12px;
    color: var(--oo-gold-light);
    font-family: var(--oo-font-display);
    font-size: clamp(19px, 2vw, 25px);
    font-style: italic;
    line-height: 1.35;
  }

  .oo-exp__rule {
    display: block;
    width: 50px;
    height: 1px;
    margin: 25px 0;
    background: linear-gradient(90deg, var(--oo-gold-light), transparent);
  }

  .oo-exp__desc {
    max-width: 48ch;
    color: rgba(234, 231, 227, .7);
    font-size: clamp(14px, 1.2vw, 17px);
    line-height: 1.8;
  }

  @keyframes geometryBreathe {
    0%, 100% { transform: scale(.95) rotate(-2deg); opacity: .62; }
    50% { transform: scale(1.03) rotate(2deg); opacity: .9; }
  }

  @media (max-width: 760px) {
    .oo-exp__list { gap: 92px; }

    .oo-exp__row {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .oo-exp__row[data-flip='true'] .oo-exp__visual { order: 0; }

    .oo-exp__visual {
      width: min(100%, 440px);
      margin: 0 auto;
    }

    .oo-exp__body {
      width: min(100%, 520px);
      margin: 0 auto;
      text-align: left;
    }

    .oo-exp__num { font-size: clamp(18px, 6vw, 24px); }
  }
</style>
