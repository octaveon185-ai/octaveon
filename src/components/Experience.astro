---
import { content, type Lang } from '../i18n/content';
import { experienceVisuals } from '../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].experience;
---

<section id="esperienza" class="oo-exp">
  <div class="oo-container">
    <header class="oo-reveal oo-exp__head">
      <p class="oo-eyebrow">{t.eyebrow}</p>
      <h2 class="oo-display oo-exp__title">{t.title}</h2>
    </header>

    <ol class="oo-exp__list">
      {t.rituals.map((ritual, index) => {
        const visual = experienceVisuals[ritual.num as keyof typeof experienceVisuals];
        const flipped = index % 2 === 1;

        return (
          <li class="oo-reveal oo-exp__row" data-flip={flipped ? 'true' : 'false'}>
            <div class="oo-exp__visual" aria-label={visual.kind === 'graphic' ? ritual.visualAlt : undefined}>
              {visual.kind === 'motion' ? (
                <div class="oo-exp__motion" role="img" aria-label={ritual.visualAlt}>
                  <img
                    class="oo-exp__motion-poster"
                    src={visual.poster}
                    alt=""
                    width={visual.width}
                    height={visual.height}
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="oo-exp__motion-live" aria-hidden="true">
                    <span class="oo-exp__motion-drop"></span>
                    <span class="oo-exp__motion-impact"></span>
                    <span class="oo-exp__motion-ripple"></span>
                    <span class="oo-exp__motion-ripple"></span>
                    <span class="oo-exp__motion-ripple"></span>
                    <span class="oo-exp__motion-ripple"></span>
                  </div>
                </div>
              ) : visual.kind === 'image' ? (
                <>
                  <picture>
                    <source
                      srcset={visual.srcSet}
                      sizes="(max-width: 760px) min(100vw - 40px, 440px), 44vw"
                      type="image/webp"
                    />
                    <img
                      src={visual.src}
                      alt={ritual.visualAlt}
                      width={visual.width}
                      height={visual.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                  {visual.credit && visual.source && (
                    <a class="oo-exp__credit" href={visual.source} target="_blank" rel="noopener">
                      {visual.credit}
                    </a>
                  )}
                </>
              ) : visual.variant === 'toroid' ? (
                <svg class="oo-exp__geometry oo-exp__geometry--toroid" viewBox="0 0 500 500" role="img" aria-label={ritual.visualAlt}>
                  <g fill="none" stroke="currentColor">
                    {Array.from({ length: 14 }).map((_, i) => (
                      <ellipse cx="250" cy="250" rx={58 + i * 11} ry="198" transform={`rotate(${i * 12.85} 250 250)`} />
                    ))}
                    <circle cx="250" cy="250" r="199" />
                    <circle cx="250" cy="250" r="56" />
                  </g>
                </svg>
              ) : (
                <svg class="oo-exp__geometry oo-exp__geometry--circle" viewBox="0 0 500 500" role="img" aria-label={ritual.visualAlt}>
                  <g fill="none" stroke="currentColor">
                    <circle cx="250" cy="250" r="58" />
                    <circle cx="250" cy="250" r="106" />
                    <circle cx="250" cy="250" r="156" />
                    <circle cx="250" cy="250" r="204" />
                    <path d="M48 250h404M250 48v404" opacity=".16" />
                  </g>
                  <circle cx="250" cy="250" r="5" fill="currentColor" />
                </svg>
              )}
            </div>

            <article class="oo-exp__body">
              <span class="oo-exp__num" aria-hidden="true">{ritual.num}</span>
              <h3 class="oo-display oo-exp__name">{ritual.name}</h3>
              <p class="oo-exp__sub">{ritual.sub}</p>
              <span class="oo-exp__rule" aria-hidden="true"></span>
              <p class="oo-exp__desc">{ritual.desc}</p>
            </article>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .oo-exp {
    position: relative;
    padding: clamp(90px, 13vh, 160px) var(--oo-gutter);
    color: var(--oo-text-on-dark);
    background:
      radial-gradient(circle at 10% 18%, rgba(18, 65, 156, .2), transparent 23%),
      linear-gradient(180deg, var(--oo-night-700), var(--oo-night-800));
    overflow: hidden;
  }

  .oo-exp__head {
    max-width: 720px;
    margin: 0 auto clamp(72px, 11vh, 130px);
    text-align: center;
  }

  .oo-exp__title {
    margin-top: 16px;
    color: var(--oo-cream-100);
    font-size: clamp(48px, 7vw, 86px);
  }

  .oo-exp__list {
    display: flex;
    flex-direction: column;
    gap: clamp(80px, 13vh, 154px);
    max-width: 1080px;
    margin: 0 auto;
    list-style: none;
  }

  .oo-exp__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, .92fr);
    align-items: center;
    gap: clamp(40px, 8vw, 110px);
  }

  .oo-exp__row[data-flip='true'] .oo-exp__visual { order: 2; }

  .oo-exp__visual {
    position: relative;
    min-width: 0;
    width: 100%;
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid rgba(230, 190, 102, .22);
    border-radius: 220px 220px 18px 18px;
    background:
      radial-gradient(circle at 50% 40%, rgba(28, 91, 196, .2), transparent 46%),
      rgba(1, 3, 19, .34);
    box-shadow: 0 34px 80px rgba(1, 3, 19, .24);
  }

  .oo-exp__visual::before {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(3, 8, 36, .06), transparent 50%, rgba(3, 8, 36, .78)),
      linear-gradient(90deg, rgba(3, 8, 36, .25), transparent 28%, transparent 72%, rgba(3, 8, 36, .25));
  }

  .oo-exp__visual img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    filter: drop-shadow(0 28px 34px rgba(1, 3, 19, .34));
    transition: transform 1.4s var(--oo-ease), filter 1.4s var(--oo-ease);
  }

  .oo-exp__visual picture {
    position: absolute;
    z-index: 0;
    inset: 16px 12px 0;
  }

  .oo-exp__row:hover .oo-exp__visual img {
    transform: translateY(-5px) scale(1.008);
    filter: drop-shadow(0 34px 40px rgba(1, 3, 19, .4));
  }

  .oo-exp__credit {
    position: absolute;
    z-index: 2;
    left: 20px;
    bottom: 17px;
    max-width: calc(100% - 40px);
    color: rgba(234, 231, 227, .72);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: .15em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .oo-exp__geometry {
    width: min(72%, 360px);
    height: auto;
    color: rgba(230, 190, 102, .58);
    filter: drop-shadow(0 0 24px rgba(198, 150, 61, .18));
  }

  .oo-exp__geometry g {
    stroke-width: 1.05;
  }

  .oo-exp__geometry--toroid {
    animation: geometryBreathe 12s ease-in-out infinite;
  }

  .oo-exp__motion {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #01030d;
  }

  .oo-exp__motion-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    filter: saturate(.8) contrast(1.06) brightness(.82);
  }

  .oo-exp__motion-live {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 50% 57%, rgba(230, 174, 72, .12), transparent 24%),
      linear-gradient(180deg, rgba(1, 3, 13, .18), rgba(1, 3, 13, .62));
  }

  .oo-exp__motion-drop {
    position: absolute;
    left: 50%;
    top: 24%;
    width: clamp(17px, 3vw, 28px);
    aspect-ratio: .74;
    border-radius: 50% 50% 58% 58%;
    background:
      radial-gradient(circle at 35% 26%, rgba(255, 245, 191, .95) 0 8%, transparent 22%),
      linear-gradient(135deg, #fff1a9 0%, #e9a83e 36%, #8b4d17 100%);
    box-shadow:
      0 0 14px rgba(235, 177, 67, .72),
      0 0 46px rgba(218, 145, 35, .28);
    transform: translate(-50%, 0) scale(.72);
    animation: ooDropFall 8.6s cubic-bezier(.45, .05, .3, 1) infinite;
  }

  .oo-exp__motion-impact {
    position: absolute;
    left: 50%;
    top: 57%;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--oo-gold-glow);
    box-shadow: 0 0 24px 8px rgba(230, 190, 102, .32);
    transform: translate(-50%, -50%) scale(.2);
    animation: ooImpact 8.6s ease-out infinite;
  }

  .oo-exp__motion-ripple {
    position: absolute;
    left: 50%;
    top: 57%;
    width: 16%;
    aspect-ratio: 2.25 / 1;
    border: 1px solid rgba(232, 177, 72, .82);
    border-radius: 50%;
    opacity: 0;
    transform: translate(-50%, -50%) scale(.25);
    box-shadow: 0 0 16px rgba(216, 151, 43, .24), inset 0 0 12px rgba(236, 184, 79, .12);
    animation: ooRipple 8.6s ease-out infinite;
  }

  .oo-exp__motion-ripple:nth-of-type(3) { animation-delay: 1.15s; }
  .oo-exp__motion-ripple:nth-of-type(4) { animation-delay: 1.55s; }
  .oo-exp__motion-ripple:nth-of-type(5) { animation-delay: 1.95s; }
  .oo-exp__motion-ripple:nth-of-type(6) { animation-delay: 2.35s; }

  @keyframes ooDropFall {
    0%, 15% { opacity: 0; transform: translate(-50%, -20px) scale(.58); }
    24% { opacity: 1; transform: translate(-50%, 0) scale(.72); }
    50%, 54% { opacity: 1; transform: translate(-50%, 175%) scale(1); }
    58%, 100% { opacity: 0; transform: translate(-50%, 220%) scale(1.18); }
  }

  @keyframes ooImpact {
    0%, 48% { opacity: 0; transform: translate(-50%, -50%) scale(.2); }
    53% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    66%, 100% { opacity: 0; transform: translate(-50%, -50%) scale(2.1); }
  }

  @keyframes ooRipple {
    0%, 8% { opacity: 0; transform: translate(-50%, -50%) scale(.25); }
    20% { opacity: .78; }
    65%, 100% { opacity: 0; transform: translate(-50%, -50%) scale(5.5); }
  }

  .oo-exp__body {
    position: relative;
    max-width: 490px;
  }

  .oo-exp__num {
    display: block;
    margin-bottom: 18px;
    color: var(--oo-gold-light);
    font-family: var(--oo-font-body);
    font-size: clamp(24px, 2.5vw, 32px);
    font-weight: 300;
    line-height: 1;
    letter-spacing: .08em;
  }

  .oo-exp__name {
    color: var(--oo-cream-100);
    font-size: clamp(35px, 4.2vw, 58px);
  }

  .oo-exp__sub {
    max-width: 38ch;
    margin-top: 12px;
    color: var(--oo-gold-light);
    font-family: var(--oo-font-display);
    font-size: clamp(19px, 2vw, 25px);
    font-style: italic;
    line-height: 1.35;
  }

  .oo-exp__rule {
    display: block;
    width: 50px;
    height: 1px;
    margin: 25px 0;
    background: linear-gradient(90deg, var(--oo-gold-light), transparent);
  }

  .oo-exp__desc {
    max-width: 48ch;
    color: rgba(234, 231, 227, .7);
    font-size: clamp(14px, 1.2vw, 17px);
    line-height: 1.8;
  }

  @keyframes geometryBreathe {
    0%, 100% { transform: scale(.95) rotate(-2deg); opacity: .62; }
    50% { transform: scale(1.03) rotate(2deg); opacity: .9; }
  }

  @media (prefers-reduced-motion: reduce) {
    .oo-exp__motion-poster { opacity: 1; }
    .oo-exp__motion-live { display: none; }
  }

  @media (max-width: 760px) {
    .oo-exp__list { gap: 92px; }

    .oo-exp__row {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .oo-exp__row[data-flip='true'] .oo-exp__visual { order: 0; }

    .oo-exp__visual {
      width: min(100%, 440px);
      margin: 0 auto;
    }

    .oo-exp__body {
      width: min(100%, 520px);
      margin: 0 auto;
      text-align: left;
    }

    .oo-exp__num { font-size: clamp(18px, 6vw, 24px); }
  }
</style>
