---
import { content, type Lang } from '../i18n/content';
import { closingVisual } from '../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const cta = content[lang].invite.submit;
---

<section class="oo-closing" aria-labelledby="closing-title">
  <div class="oo-container oo-closing__grid">
    <div class="oo-reveal oo-closing__content">
      <p class="oo-eyebrow">A RETURN TO PRESENCE</p>
      <h2 id="closing-title" class="oo-display">The circle awaits.</h2>
      <a class="oo-btn oo-btn--primary" href="#invito">{cta}</a>
    </div>

    <figure class="oo-reveal oo-closing__visual">
      <img
        src={closingVisual.src}
        alt={closingVisual.alt}
        width={closingVisual.width}
        height={closingVisual.height}
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        <a href={closingVisual.source} target="_blank" rel="noopener">{closingVisual.credit}</a>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .oo-closing {
    position: relative;
    padding: clamp(90px, 13vh, 160px) var(--oo-gutter) 0;
    overflow: hidden;
    background:
      radial-gradient(circle at 72% 30%, rgba(18, 65, 156, .18), transparent 34%),
      linear-gradient(180deg, var(--oo-night-800), var(--oo-night-900));
  }

  .oo-closing__grid {
    min-height: min(720px, 78vh);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, .78fr);
    align-items: center;
    gap: clamp(40px, 8vw, 110px);
  }

  .oo-closing__content {
    position: relative;
    z-index: 2;
    padding-bottom: clamp(80px, 12vh, 140px);
  }

  .oo-closing__content h2 {
    max-width: 620px;
    margin: 18px 0 38px;
    color: var(--oo-cream-100);
    font-size: clamp(58px, 8vw, 108px);
    line-height: .92;
    text-wrap: balance;
  }

  .oo-closing__visual {
    position: relative;
    align-self: end;
    max-width: 510px;
    margin: 0;
  }

  .oo-closing__visual::before {
    content: '';
    position: absolute;
    z-index: 0;
    inset: 10% -12% 0;
    border: 1px solid rgba(230, 190, 102, .22);
    border-bottom: 0;
    border-radius: 240px 240px 0 0;
  }

  .oo-closing__visual::after {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, var(--oo-night-900) 100%);
    pointer-events: none;
  }

  .oo-closing__visual img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    filter: grayscale(1) contrast(1.08);
    mix-blend-mode: luminosity;
  }

  .oo-closing__visual figcaption {
    position: absolute;
    z-index: 2;
    right: 10px;
    bottom: 18px;
  }

  .oo-closing__visual figcaption a {
    color: rgba(234, 231, 227, .48);
    font-size: 7px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .oo-closing { padding-top: 96px; }

    .oo-closing__grid {
      min-height: 0;
      grid-template-columns: 1fr;
      text-align: center;
    }

    .oo-closing__content { padding-bottom: 0; }

    .oo-closing__visual {
      width: min(92%, 430px);
      margin: 10px auto 0;
    }
  }
</style>
