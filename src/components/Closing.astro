---
import { content, type Lang } from '../i18n/content';
import { closingVisual } from '../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].closing;
---

<section class="oo-closing" aria-labelledby="closing-title">
  <div class="oo-container oo-closing__grid">
    <div class="oo-reveal oo-closing__content">
      <p class="oo-eyebrow">{t.eyebrow}</p>
      <h2 id="closing-title" class="oo-display">{t.title}</h2>
      <a class="oo-btn oo-btn--primary" href="#invito">{t.cta}</a>
    </div>

    <figure class="oo-reveal oo-closing__visual">
      <picture>
        <source
          srcset={closingVisual.srcSet}
          sizes="(max-width: 760px) min(92vw, 430px), 42vw"
          type="image/webp"
        />
        <img
          src={closingVisual.src}
          alt={t.visualAlt}
          width={closingVisual.width}
          height={closingVisual.height}
          loading="lazy"
          decoding="async"
        />
      </picture>
    </figure>
  </div>
</section>

<style>
  .oo-closing {
    position: relative;
    padding: clamp(90px, 13vh, 160px) var(--oo-gutter) 0;
    overflow: hidden;
    background:
      radial-gradient(circle at 72% 30%, rgba(18, 65, 156, .18), transparent 34%),
      linear-gradient(180deg, var(--oo-night-800), var(--oo-night-900));
  }

  .oo-closing__grid {
    min-height: min(720px, 78vh);
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, .72fr);
    align-items: center;
    gap: clamp(40px, 8vw, 110px);
  }

  .oo-closing__content {
    position: relative;
    z-index: 2;
    padding-bottom: clamp(80px, 12vh, 140px);
  }

  .oo-closing__content h2 {
    max-width: 760px;
    margin: 18px 0 38px;
    color: var(--oo-cream-100);
    font-size: clamp(52px, 7vw, 98px);
    line-height: .94;
    text-wrap: balance;
  }

  .oo-closing__visual {
    position: relative;
    align-self: end;
    width: 100%;
    max-width: 560px;
    min-height: 620px;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(230, 190, 102, .18);
    border-bottom: 0;
    border-radius: 280px 280px 0 0;
    background: radial-gradient(circle at 50% 45%, rgba(18, 65, 156, .28), transparent 50%);
  }

  .oo-closing__visual::after {
    content: '';
    position: absolute;
    z-index: 2;
    inset: auto 0 0;
    height: 24%;
    background: linear-gradient(transparent, var(--oo-night-900));
    pointer-events: none;
  }

  .oo-closing__visual picture {
    position: absolute;
    inset: 0;
  }

  .oo-closing__visual img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    filter: drop-shadow(0 34px 40px rgba(1, 3, 19, .38));
    transition: transform 1.4s var(--oo-ease);
  }

  .oo-closing__visual:hover img {
    transform: translateY(-5px) scale(1.008);
  }

  @media (max-width: 760px) {
    .oo-closing { padding-top: 96px; }

    .oo-closing__grid {
      min-height: 0;
      grid-template-columns: 1fr;
      text-align: center;
    }

    .oo-closing__content { padding-bottom: 0; }

    .oo-closing__visual {
      width: min(92%, 430px);
      min-height: 510px;
      margin: 10px auto 0;
    }
  }
</style>
