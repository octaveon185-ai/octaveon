---
import { content, type Lang } from '../i18n/content';
import { closingVisual } from '../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].closing;
---

<section class="oo-closing" aria-labelledby="closing-title">
  <div class="oo-container oo-closing__grid">
    <div class="oo-reveal oo-closing__content">
      <p class="oo-eyebrow">{t.eyebrow}</p>
      <h2 id="closing-title" class="oo-display">{t.title}</h2>
      <a class="oo-btn oo-btn--primary" href="#invito">{t.cta}</a>
    </div>

    <figure class="oo-reveal oo-closing__visual" aria-label={closingVisual.label}>
      <span class="oo-closing__halo" aria-hidden="true"></span>
      <span class="oo-closing__plinth" aria-hidden="true"></span>
      <figcaption>
        <small>{t.pending}</small>
        <strong>{closingVisual.composition}</strong>
        <code>{closingVisual.plannedSrc}</code>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .oo-closing {
    position: relative;
    padding: clamp(90px, 13vh, 160px) var(--oo-gutter) 0;
    overflow: hidden;
    background:
      radial-gradient(circle at 72% 30%, rgba(18, 65, 156, .18), transparent 34%),
      linear-gradient(180deg, var(--oo-night-800), var(--oo-night-900));
  }

  .oo-closing__grid {
    min-height: min(720px, 78vh);
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, .72fr);
    align-items: center;
    gap: clamp(40px, 8vw, 110px);
  }

  .oo-closing__content {
    position: relative;
    z-index: 2;
    padding-bottom: clamp(80px, 12vh, 140px);
  }

  .oo-closing__content h2 {
    max-width: 760px;
    margin: 18px 0 38px;
    color: var(--oo-cream-100);
    font-size: clamp(52px, 7vw, 98px);
    line-height: .94;
    text-wrap: balance;
  }

  .oo-closing__visual {
    position: relative;
    align-self: end;
    width: 100%;
    max-width: 520px;
    min-height: 600px;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(230, 190, 102, .2);
    border-bottom: 0;
    border-radius: 260px 260px 0 0;
    background:
      linear-gradient(rgba(230, 190, 102, .035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(230, 190, 102, .035) 1px, transparent 1px),
      radial-gradient(circle at 50% 38%, rgba(18, 65, 156, .28), transparent 42%);
    background-size: 36px 36px, 36px 36px, auto;
  }

  .oo-closing__halo {
    position: absolute;
    left: 50%;
    top: 21%;
    width: 68%;
    aspect-ratio: 1;
    translate: -50% 0;
    border: 1px solid rgba(230, 190, 102, .28);
    border-radius: 50%;
    box-shadow: 0 0 0 54px rgba(230, 190, 102, .025);
  }

  .oo-closing__plinth {
    position: absolute;
    left: 50%;
    bottom: 16%;
    width: 70%;
    height: 29%;
    translate: -50% 0;
    border: 1px solid rgba(230, 190, 102, .4);
    border-radius: 52% 48% 12% 12%;
    clip-path: polygon(6% 64%, 23% 26%, 52% 8%, 88% 22%, 100% 70%, 89% 88%, 7% 92%);
    opacity: .54;
  }

  .oo-closing__visual figcaption {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    gap: 8px;
    padding: 42px 28px 28px;
    text-align: center;
    background: linear-gradient(transparent, var(--oo-night-900));
  }

  .oo-closing__visual small {
    color: var(--oo-gold-light);
    font-size: 7px;
    font-weight: 700;
    letter-spacing: .2em;
  }

  .oo-closing__visual strong {
    color: rgba(234, 231, 227, .72);
    font-family: var(--oo-font-display);
    font-size: 20px;
    font-weight: 400;
    letter-spacing: .06em;
  }

  .oo-closing__visual code {
    color: rgba(170, 181, 209, .42);
    font-size: 7px;
  }

  @media (max-width: 760px) {
    .oo-closing { padding-top: 96px; }

    .oo-closing__grid {
      min-height: 0;
      grid-template-columns: 1fr;
      text-align: center;
    }

    .oo-closing__content { padding-bottom: 0; }

    .oo-closing__visual {
      width: min(92%, 430px);
      min-height: 510px;
      margin: 10px auto 0;
    }
  }
</style>
