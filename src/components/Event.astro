---
import { content, type Lang } from '../i18n/content';
import { eventDetails } from '../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].event;
const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(eventDetails.venue)}`;
---

<section id="evento" class="oo-event">
  <div class="oo-container oo-event__grid">
    <div class="oo-reveal oo-event__media">
      <picture>
        <source srcset={eventDetails.image.srcSet} sizes="(max-width: 820px) 100vw, 46vw" type="image/webp" />
        <img
          src={eventDetails.image.src}
          alt={t.imageAlt}
          width={eventDetails.image.width}
          height={eventDetails.image.height}
          loading="lazy"
          decoding="async"
        />
      </picture>
      <span class="oo-event__imageLabel">{t.imageLabel}</span>
    </div>

    <article class="oo-reveal oo-event__content">
      <p class="oo-eyebrow">{t.eyebrow}</p>
      <h2 class="oo-display oo-event__title">{t.title}</h2>

      <div class="oo-event__facts">
        <p>{t.date} <span>—</span> {t.location}</p>
        <time>{t.time}</time>
      </div>

      <div class="oo-event__essentials" aria-label="Event essentials">
        <div class="oo-event__essential">
          <small>{t.priceLabel}</small>
          <strong>{t.price}</strong>
        </div>
        <div class="oo-event__essential oo-event__essential--dress">
          <small>{t.dressCodeLabel}</small>
          <p>{t.dressCode}</p>
        </div>
      </div>

      <a class="oo-event__venue" href={mapHref} target="_blank" rel="noopener">
        <span class="oo-event__venueLogo" aria-hidden="true">
          <img
            src={eventDetails.venueLogo.src}
            alt=""
            width={eventDetails.venueLogo.width}
            height={eventDetails.venueLogo.height}
            loading="lazy"
            decoding="async"
          />
        </span>
        <span>
          <small>{t.hostVenue}</small>
          <strong>{eventDetails.venueName}</strong>
          <em>{eventDetails.venueArea}</em>
        </span>
      </a>

      <p class="oo-event__note">{t.note}</p>
      <a class="oo-btn oo-btn--primary" href="#invito">{t.cta}</a>
    </article>
  </div>
</section>

<style>
  .oo-event {
    position: relative;
    padding: clamp(90px, 14vh, 170px) var(--oo-gutter);
    overflow: hidden;
    background:
      radial-gradient(circle at 88% 12%, rgba(19, 75, 183, .18), transparent 30%),
      linear-gradient(180deg, var(--oo-night-700), var(--oo-night-800));
  }

  .oo-event__grid {
    display: grid;
    grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr);
    align-items: center;
    gap: clamp(42px, 8vw, 112px);
  }

  .oo-event__media {
    position: relative;
    min-height: 680px;
    overflow: hidden;
    border: 1px solid rgba(230, 190, 102, .24);
    border-radius: 240px 240px 16px 16px;
  }

  .oo-event__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(3, 8, 36, .06), transparent 46%, rgba(3, 8, 36, .8)),
      rgba(3, 8, 36, .08);
    pointer-events: none;
  }

  .oo-event__media picture,
  .oo-event__media img {
    width: 100%;
    height: 100%;
  }

  .oo-event__media img {
    position: absolute;
    inset: 0;
    object-fit: cover;
    object-position: center;
  }

  .oo-event__imageLabel {
    position: absolute;
    z-index: 1;
    left: 24px;
    bottom: 22px;
    color: rgba(234, 231, 227, .72);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .23em;
  }

  .oo-event__content {
    max-width: 590px;
  }

  .oo-event__title {
    margin-top: 18px;
    color: var(--oo-cream-100);
    font-size: clamp(52px, 6.5vw, 86px);
    text-transform: uppercase;
    text-wrap: balance;
  }

  .oo-event__facts {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: clamp(38px, 6vh, 60px);
    padding-block: 27px;
    border-block: 1px solid rgba(230, 190, 102, .2);
  }

  .oo-event__venue small {
    display: block;
    margin-bottom: 8px;
    color: var(--oo-gold-light);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .23em;
  }

  .oo-event__facts p,
  .oo-event__facts time {
    color: var(--oo-cream-100);
    font-family: var(--oo-font-display);
    font-size: clamp(24px, 2.6vw, 34px);
    line-height: 1.18;
    text-transform: uppercase;
  }

  .oo-event__facts span { color: var(--oo-gold-light); }

  .oo-event__essentials {
    display: grid;
    grid-template-columns: minmax(0, .72fr) minmax(0, 1.28fr);
    gap: 18px;
    margin-top: 22px;
  }

  .oo-event__essential {
    min-height: 92px;
    padding: 18px 20px;
    border: 1px solid rgba(230, 190, 102, .2);
    border-radius: 10px;
    background: rgba(3, 8, 36, .2);
  }

  .oo-event__essential small {
    display: block;
    margin-bottom: 11px;
    color: var(--oo-gold-light);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .2em;
  }

  .oo-event__essential strong {
    display: block;
    color: var(--oo-cream-100);
    font-family: var(--oo-font-display);
    font-size: clamp(20px, 2vw, 27px);
    font-weight: 500;
    line-height: 1.1;
  }

  .oo-event__essential p {
    max-width: 29ch;
    color: var(--oo-cream-100);
    font-size: 14px;
    line-height: 1.45;
  }

  .oo-event__facts time {
    color: var(--oo-gold-light);
    font-family: var(--oo-font-body);
    font-size: clamp(12px, 1.2vw, 15px);
    font-weight: 700;
    letter-spacing: .18em;
  }

  .oo-event__venue {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 18px;
    margin-top: 28px;
    padding: 18px 22px;
    border-radius: 10px;
    background: var(--oo-cream-100);
    color: var(--oo-night-800);
    transition: transform .3s var(--oo-ease), box-shadow .3s;
  }

  .oo-event__venue:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 50px rgba(1, 3, 19, .3);
  }

  .oo-event__venue small { color: var(--oo-gold-dark); }

  .oo-event__venue strong {
    display: block;
  }

  .oo-event__venue strong {
    font-family: var(--oo-font-display);
    font-size: clamp(22px, 2vw, 29px);
    font-weight: 500;
    line-height: 1;
  }

  .oo-event__venue em {
    display: block;
    margin-top: 7px;
    color: var(--oo-gold-dark);
    font-size: 9px;
    font-style: normal;
    font-weight: 700;
    letter-spacing: .2em;
  }

  .oo-event__venueLogo {
    position: relative;
    display: grid;
    flex: 0 0 70px;
    place-items: center;
    width: 70px;
    height: 70px;
    overflow: hidden;
    border: 1px solid rgba(3, 8, 36, .16);
    border-radius: 50%;
    background: var(--oo-cream-100);
  }

  .oo-event__venueLogo::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 5px rgba(246, 242, 235, .42);
    pointer-events: none;
  }

  .oo-event__venueLogo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    mix-blend-mode: multiply;
    transform: scale(1.02);
  }

  .oo-event__note {
    max-width: 50ch;
    margin: 28px 0 32px;
    color: var(--oo-slate);
    line-height: 1.75;
  }

  @media (max-width: 820px) {
    .oo-event__grid { grid-template-columns: 1fr; }

    .oo-event__media {
      min-height: 0;
      width: min(100%, 560px);
      aspect-ratio: 4 / 5;
      margin: 0 auto;
    }

    .oo-event__content { max-width: 620px; }

    .oo-event__essentials { grid-template-columns: 1fr; }
  }

</style>
