---
import { content, type Lang } from '../i18n/content';
import { galleryAssets } from '../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].gallery;
---

<section id="gallery" class="oo-gallery">
  <div class="oo-container">
    <header class="oo-reveal oo-gallery__head">
      <p class="oo-eyebrow">{t.eyebrow}</p>
      <h2 class="oo-display oo-gallery__title">{t.title}</h2>
    </header>

    <div class="oo-reveal oo-reveal--soft oo-gallery__grid">
      {galleryAssets.map((asset, index) => (
        <figure class="oo-gallery__tile" data-placeholder={asset.kind === 'placeholder' ? 'true' : 'false'}>
          {asset.kind === 'image' ? (
            <picture>
              <source srcset={asset.srcSet} sizes="(max-width: 760px) 100vw, 50vw" type="image/webp" />
              <img
                src={asset.src}
                alt={asset.alt}
                width={asset.width}
                height={asset.height}
                loading="lazy"
                decoding="async"
              />
            </picture>
          ) : (
            <div class="oo-gallery__placeholder" aria-label={asset.label}>
              <span class="oo-gallery__placeholderMark" aria-hidden="true"><i></i><i></i></span>
              <small>{t.pending}</small>
              <strong>{asset.label}</strong>
              <code>{asset.key}</code>
            </div>
          )}
          <figcaption>{t.tiles[index]}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .oo-gallery {
    position: relative;
    padding: clamp(90px, 13vh, 160px) var(--oo-gutter);
    background: linear-gradient(180deg, var(--oo-night-800), var(--oo-night-700));
  }

  .oo-gallery__head {
    max-width: 740px;
    margin: 0 auto clamp(46px, 7vh, 76px);
    text-align: center;
  }

  .oo-gallery__title {
    margin-top: 16px;
    color: var(--oo-cream-100);
    font-size: var(--oo-fs-h2);
  }

  .oo-gallery__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: clamp(190px, 24vw, 300px);
    gap: 16px;
  }

  .oo-gallery__tile {
    position: relative;
    grid-column: span 4;
    overflow: hidden;
    margin: 0;
    border: 1px solid rgba(230, 190, 102, .17);
    border-radius: 10px;
    background: rgba(1, 3, 19, .34);
  }

  .oo-gallery__tile:nth-child(1),
  .oo-gallery__tile:nth-child(4) { grid-column: span 8; }

  .oo-gallery__tile:nth-child(5),
  .oo-gallery__tile:nth-child(6) { grid-column: span 6; }

  .oo-gallery__tile picture,
  .oo-gallery__tile img {
    width: 100%;
    height: 100%;
  }

  .oo-gallery__tile img {
    object-fit: cover;
    transition: transform 1.1s var(--oo-ease);
  }

  .oo-gallery__tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(3, 8, 36, .06), transparent 45%, rgba(1, 3, 19, .84));
    pointer-events: none;
  }

  .oo-gallery__tile:hover img { transform: scale(1.03); }

  .oo-gallery__tile figcaption {
    position: absolute;
    z-index: 2;
    left: 18px;
    bottom: 15px;
    color: var(--oo-cream-100);
    font-family: var(--oo-font-display);
    font-size: clamp(16px, 1.5vw, 21px);
    font-style: italic;
  }

  .oo-gallery__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 8px;
    padding: 34px;
    text-align: center;
    background:
      linear-gradient(rgba(230, 190, 102, .035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(230, 190, 102, .035) 1px, transparent 1px),
      radial-gradient(circle, rgba(19, 75, 183, .18), transparent 60%);
    background-size: 28px 28px, 28px 28px, auto;
  }

  .oo-gallery__placeholder small {
    color: var(--oo-gold-light);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: .22em;
  }

  .oo-gallery__placeholder strong {
    max-width: 28ch;
    color: rgba(234, 231, 227, .78);
    font-family: var(--oo-font-display);
    font-size: clamp(19px, 2vw, 28px);
    font-weight: 400;
  }

  .oo-gallery__placeholder code {
    color: rgba(170, 181, 209, .48);
    font-size: 8px;
  }

  .oo-gallery__placeholderMark {
    position: relative;
    width: 50px;
    height: 32px;
    margin-bottom: 10px;
  }

  .oo-gallery__placeholderMark i {
    position: absolute;
    width: 32px;
    height: 32px;
    border: 1px solid rgba(230, 190, 102, .7);
    border-radius: 50%;
  }

  .oo-gallery__placeholderMark i:first-child { left: 0; }
  .oo-gallery__placeholderMark i:last-child { right: 0; }

  .oo-gallery__tile[data-placeholder='true']::after {
    background: linear-gradient(180deg, transparent 50%, rgba(1, 3, 19, .82));
  }

  @media (max-width: 760px) {
    .oo-gallery__grid {
      grid-template-columns: 1fr;
      grid-auto-rows: min(72vw, 330px);
    }

    .oo-gallery__tile,
    .oo-gallery__tile:nth-child(1),
    .oo-gallery__tile:nth-child(4),
    .oo-gallery__tile:nth-child(5),
    .oo-gallery__tile:nth-child(6) { grid-column: auto; }
  }
</style>
