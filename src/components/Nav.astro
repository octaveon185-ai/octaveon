---
import { content, locales, localeLabels, languageNames, homeHref, type Lang } from '../i18n/content';
import { journalArticleHref } from '../i18n/journalArticle';

interface Props {
  lang: Lang;
  context?: 'home' | 'article';
}
const { lang, context = 'home' } = Astro.props;
const t = content[lang].nav;
const sectionPrefix = context === 'article' ? homeHref(lang) : '';
---

<nav class="oo-nav" aria-label={t.ariaLabel} data-scrolled="false">
  <ul class="oo-nav__links">
    {t.links.map((l) => (
      <li><a href={`${sectionPrefix}${l.href}`}>{l.label}</a></li>
    ))}
  </ul>

  <div class="oo-nav__actions">
    <div class="oo-nav__languages" aria-label={t.switchLanguage}>
      {locales.map((locale) => locale === lang ? (
        <span class="oo-nav__lang" aria-current="page">{localeLabels[locale]}</span>
      ) : (
        <a
          class="oo-nav__lang"
          href={context === 'article' ? journalArticleHref(locale) : homeHref(locale)}
          hreflang={locale}
          lang={locale}
          aria-label={`${t.switchLanguage} ${languageNames[locale]}`}
        >{localeLabels[locale]}</a>
      ))}
    </div>
    <a class="oo-nav__cta" href={`${sectionPrefix}#invito`}>{t.cta}</a>
  </div>
</nav>

<style>
  .oo-nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 18px;
    padding: 16px clamp(20px, 4vw, 56px);
    border-bottom: 1px solid transparent;
    background: rgba(2, 5, 27, 0);
    transition:
      padding .35s var(--oo-ease),
      background .35s,
      border-color .35s,
      backdrop-filter .35s;
  }

  .oo-nav[data-scrolled='true'] {
    padding-block: 11px;
    border-color: rgba(230, 190, 102, .14);
    background: rgba(2, 5, 27, .84);
    backdrop-filter: blur(16px) saturate(1.15);
  }

  .oo-nav__links {
    display: flex;
    gap: clamp(18px, 2.4vw, 36px);
    list-style: none;
    margin-left: auto;
  }
  .oo-nav__links a {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--oo-cream-100);
    opacity: 0.82;
    transition: color 0.25s, opacity 0.25s;
  }
  .oo-nav__links a:hover {
    color: var(--oo-gold-light);
    opacity: 1;
  }

  .oo-nav__actions {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-left: clamp(24px, 4vw, 56px);
  }
  .oo-nav__lang {
    font-size: 12px;
    letter-spacing: 0.16em;
    font-weight: 600;
    color: var(--oo-slate);
    transition: color 0.25s;
  }
  .oo-nav__languages {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .oo-nav__lang[aria-current='page'] {
    color: var(--oo-cream-100);
    opacity: .5;
  }
  .oo-nav__lang:hover { color: var(--oo-gold-light); }

  .oo-nav__cta {
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--oo-gold-light);
    border: 1px solid rgba(224, 174, 99, 0.4);
    border-radius: var(--oo-radius-pill);
    padding: 10px 20px;
    transition: border-color 0.25s, background 0.25s, color 0.25s;
  }
  .oo-nav__cta:hover {
    border-color: var(--oo-gold-light);
    background: rgba(224, 174, 99, 0.1);
  }

  @media (max-width: 760px) {
    .oo-nav__links { display: none; }
  }
  @media (max-width: 560px) {
    .oo-nav {
      padding: 11px 18px;
    }
    .oo-nav__actions { gap: 10px; margin-left: auto; }
    .oo-nav__cta {
      display: inline-flex;
      padding: 9px 12px;
      font-size: 8px;
      letter-spacing: .1em;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('.oo-nav');
  const updateNav = () => nav?.setAttribute('data-scrolled', window.scrollY > 48 ? 'true' : 'false');
  updateNav();
  addEventListener('scroll', updateNav, { passive: true });
</script>
