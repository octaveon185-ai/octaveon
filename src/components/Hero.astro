---
import { content, type Lang } from '../i18n/content';
import { heroMedia } from '../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].hero;
const primaryCta = content[lang].nav.cta;
---

<header id="hero" class="oo-hero">
  <div class="oo-hero__media" aria-hidden="true">
    <img
      class="oo-hero__poster"
      src={heroMedia.poster.src}
      alt=""
      width={heroMedia.poster.width}
      height={heroMedia.poster.height}
      decoding="sync"
      fetchpriority="high"
    />
    {heroMedia.video.enabled && (
      <video
        class="oo-hero__video"
        poster={heroMedia.poster.src}
        muted
        autoplay
        loop
        playsinline
        preload="metadata"
      >
        <source src={heroMedia.video.webm} type="video/webm" />
        <source src={heroMedia.video.mp4} type="video/mp4" />
      </video>
    )}
  </div>

  <div class="oo-hero__inner">
    <div class="oo-hero__brand">
      <img
        src="/brand/octave-on-logo.png"
        alt="Octave On"
        width="1064"
        height="671"
        decoding="async"
        fetchpriority="high"
      />
    </div>

    <h1 class="oo-hero__tagline">{t.tagline}</h1>

    <div class="oo-hero__actions">
      <a class="oo-btn oo-btn--primary" href="#invito">{primaryCta}</a>
      <a class="oo-hero__explore" href="#esperienza">
        <span>{t.explore}</span><i aria-hidden="true">↓</i>
      </a>
    </div>
  </div>

  {!heroMedia.video.enabled && (
    <span class="oo-hero__assetNote">CINEMATIC LOOP · ASSET PENDING</span>
  )}
</header>

<style>
  .oo-hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 108px var(--oo-gutter) 78px;
    overflow: hidden;
    isolation: isolate;
    text-align: center;
    background: var(--oo-night-900);
  }

  .oo-hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(1, 3, 19, .7) 0%, rgba(2, 6, 27, .26) 35%, rgba(2, 6, 27, .42) 70%, var(--oo-night-800) 100%),
      radial-gradient(ellipse at 50% 44%, transparent 18%, rgba(1, 3, 19, .52) 88%);
    pointer-events: none;
  }

  .oo-hero::after {
    content: '';
    position: absolute;
    z-index: 0;
    inset: auto 0 -1px;
    height: clamp(110px, 18vh, 200px);
    background: linear-gradient(180deg, transparent, var(--oo-night-800));
    pointer-events: none;
  }

  .oo-hero__media {
    position: absolute;
    z-index: -2;
    inset: 0;
    overflow: hidden;
  }

  .oo-hero__poster,
  .oo-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 54%;
    filter: saturate(.82) contrast(1.06) brightness(.76);
    transform: scale(1.015);
  }

  .oo-hero__video {
    position: absolute;
    inset: 0;
  }

  .oo-hero__inner {
    position: relative;
    z-index: 2;
    width: min(100%, 960px);
    padding: clamp(10px, 2vw, 24px);
  }

  .oo-hero__inner::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -28% -14%;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(1, 3, 19, .8) 0%, rgba(1, 3, 19, .38) 50%, transparent 74%);
    filter: blur(10px);
  }

  .oo-hero__brand {
    width: clamp(350px, 43vw, 570px);
    margin: 0 auto;
    filter:
      drop-shadow(0 0 26px rgba(230, 190, 102, .42))
      drop-shadow(0 22px 52px rgba(1, 3, 19, .76));
  }

  .oo-hero__brand img {
    width: 100%;
    height: auto;
  }

  .oo-hero__tagline {
    max-width: 780px;
    margin: -3px auto 0;
    color: var(--oo-cream-100);
    font-family: var(--oo-font-body);
    font-size: clamp(13px, 1.3vw, 17px);
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: .3em;
    text-transform: uppercase;
    text-wrap: balance;
    text-shadow: 0 3px 24px rgba(1, 3, 19, .9);
  }

  .oo-hero__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(20px, 3vw, 38px);
    margin-top: clamp(32px, 5vh, 54px);
  }

  .oo-hero__actions .oo-btn {
    min-width: min(100%, 248px);
  }

  .oo-hero__explore {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 0 9px;
    border-bottom: 1px solid rgba(230, 190, 102, .5);
    color: var(--oo-gold-light);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .22em;
    transition: border-color .3s, color .3s;
  }

  .oo-hero__explore i {
    font-size: 15px;
    font-style: normal;
    transition: transform .3s var(--oo-ease);
  }

  .oo-hero__explore:hover {
    border-color: var(--oo-gold-glow);
    color: var(--oo-gold-glow);
  }

  .oo-hero__explore:hover i { transform: translateY(3px); }

  .oo-hero__assetNote {
    position: absolute;
    z-index: 2;
    right: clamp(18px, 3vw, 42px);
    bottom: 25px;
    color: rgba(234, 231, 227, .34);
    font-size: 7px;
    font-weight: 700;
    letter-spacing: .2em;
  }

  @media (max-width: 640px) {
    .oo-hero {
      min-height: 94svh;
      padding: 88px 18px 76px;
    }

    .oo-hero__poster,
    .oo-hero__video {
      object-position: 50% 50%;
      transform: scale(1.12);
    }

    .oo-hero__brand { width: min(92vw, 370px); }

    .oo-hero__tagline {
      max-width: 350px;
      font-size: 10.5px;
      letter-spacing: .2em;
    }

    .oo-hero__actions {
      flex-direction: column;
      gap: 13px;
      margin-top: 32px;
    }

    .oo-hero__explore { font-size: 9px; }
    .oo-hero__assetNote { right: 16px; bottom: 18px; font-size: 6px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .oo-hero__video { display: none; }
    .oo-hero__poster { transform: none; }
  }
</style>
