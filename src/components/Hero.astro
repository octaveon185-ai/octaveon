---
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].hero;
---

<header id="hero" class="oo-hero">
  <div class="oo-hero__resonance" aria-hidden="true">
    <svg viewBox="0 0 1200 760" preserveAspectRatio="xMidYMid slice">
      <defs>
        <radialGradient id="waterGlow">
          <stop offset="0" stop-color="#e6be66" stop-opacity=".14" />
          <stop offset=".55" stop-color="#164aa3" stop-opacity=".08" />
          <stop offset="1" stop-color="#030824" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="dropGold" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="#ffe19a" />
          <stop offset="1" stop-color="#c6963d" />
        </linearGradient>
      </defs>
      <ellipse cx="600" cy="470" rx="510" ry="230" fill="url(#waterGlow)" />
      <path class="oo-hero__drop" d="M600 216C583 244 571 261 571 281a29 29 0 0 0 58 0c0-20-12-37-29-65Z" fill="url(#dropGold)" />
      <g class="oo-hero__rings" fill="none" stroke="#e6be66">
        <ellipse class="oo-hero__ring oo-hero__ring--1" cx="600" cy="470" rx="92" ry="32" />
        <ellipse class="oo-hero__ring oo-hero__ring--2" cx="600" cy="470" rx="188" ry="66" />
        <ellipse class="oo-hero__ring oo-hero__ring--3" cx="600" cy="470" rx="310" ry="109" />
        <ellipse class="oo-hero__ring oo-hero__ring--4" cx="600" cy="470" rx="450" ry="158" />
      </g>
      <path class="oo-hero__horizon" d="M0 470H1200" />
    </svg>
  </div>

  <div class="oo-hero__inner">
    <div class="oo-hero__brand">
      <img
        src="/brand/octave-on-logo.png"
        alt="Octave On"
        width="1064"
        height="671"
        decoding="async"
        fetchpriority="high"
      />
    </div>
    <h1 class="oo-hero__tagline">{t.tagline}</h1>
    <a class="oo-hero__explore" href="#esperienza">
      <span>{t.explore}</span><i aria-hidden="true">↓</i>
    </a>
  </div>
</header>

<style>
  .oo-hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 112px var(--oo-gutter) 72px;
    overflow: hidden;
    isolation: isolate;
    text-align: center;
    background:
      radial-gradient(circle at 50% 40%, rgba(13, 57, 142, 0.46), transparent 32%),
      linear-gradient(180deg, #02051b 0%, #051641 53%, #030824 100%);
  }

  .oo-hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(1, 3, 19, .48), transparent 24%, transparent 76%, rgba(1, 3, 19, .48)),
      radial-gradient(ellipse at center, transparent 28%, rgba(1, 3, 19, .52) 100%);
    pointer-events: none;
  }

  .oo-hero::after {
    content: '';
    position: absolute;
    z-index: 0;
    inset: auto 0 -1px;
    height: clamp(100px, 16vh, 180px);
    background: linear-gradient(180deg, transparent, var(--oo-night-800));
    pointer-events: none;
  }

  .oo-hero__resonance {
    position: absolute;
    z-index: -1;
    inset: 0;
    opacity: .72;
    pointer-events: none;
  }

  .oo-hero__resonance svg {
    width: 100%;
    height: 100%;
  }

  .oo-hero__drop {
    transform-box: fill-box;
    transform-origin: center;
    animation: dropFall 10s var(--oo-ease) infinite;
    filter: drop-shadow(0 0 12px rgba(230, 190, 102, .48));
  }

  .oo-hero__rings {
    stroke-width: 1.2;
  }

  .oo-hero__ring {
    transform-box: fill-box;
    transform-origin: center;
    animation: resonance 10s var(--oo-ease) infinite;
  }

  .oo-hero__ring--1 { animation-delay: 0s; }
  .oo-hero__ring--2 { animation-delay: .45s; }
  .oo-hero__ring--3 { animation-delay: .9s; }
  .oo-hero__ring--4 { animation-delay: 1.35s; }

  .oo-hero__horizon {
    fill: none;
    stroke: rgba(170, 181, 209, .12);
    stroke-width: 1;
  }

  .oo-hero__inner {
    position: relative;
    z-index: 2;
    width: min(100%, 900px);
    padding: clamp(12px, 3vw, 34px);
  }

  .oo-hero__inner::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -20% -14%;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(2, 5, 27, .94) 0%, rgba(2, 5, 27, .64) 43%, transparent 73%);
    filter: blur(8px);
  }

  .oo-hero__brand {
    width: clamp(340px, 42vw, 560px);
    margin: 0 auto;
    filter:
      drop-shadow(0 0 28px rgba(230, 190, 102, .46))
      drop-shadow(0 20px 48px rgba(1, 3, 19, .72));
  }

  .oo-hero__brand img {
    width: 100%;
    height: auto;
  }

  .oo-hero__tagline {
    max-width: 720px;
    margin: clamp(-4px, -.3vw, 2px) auto 0;
    color: var(--oo-cream-100);
    font-family: var(--oo-font-body);
    font-size: clamp(12px, 1.2vw, 16px);
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: .28em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .oo-hero__explore {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: clamp(34px, 5vh, 58px);
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(230, 190, 102, .4);
    color: var(--oo-gold-light);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .25em;
    transition: border-color .3s, color .3s;
  }

  .oo-hero__explore i {
    font-size: 15px;
    font-style: normal;
    transition: transform .3s var(--oo-ease);
  }

  .oo-hero__explore:hover {
    border-color: var(--oo-gold-glow);
    color: var(--oo-gold-glow);
  }

  .oo-hero__explore:hover i { transform: translateY(3px); }

  @keyframes dropFall {
    0%, 14% { transform: translateY(-78px); opacity: 0; }
    20% { opacity: 1; }
    36% { transform: translateY(170px); opacity: 1; }
    40%, 100% { transform: translateY(174px); opacity: 0; }
  }

  @keyframes resonance {
    0%, 34% { opacity: 0; transform: scale(.72); }
    42% { opacity: .72; }
    76%, 100% { opacity: 0; transform: scale(1.12); }
  }

  @media (max-width: 640px) {
    .oo-hero {
      min-height: 92svh;
      padding-top: 92px;
    }

    .oo-hero__brand { width: min(86vw, 340px); }

    .oo-hero__tagline {
      max-width: 340px;
      font-size: 10px;
      letter-spacing: .18em;
    }

    .oo-hero__resonance {
      inset: 10% -45% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .oo-hero__drop { transform: translateY(174px); opacity: .75; }
    .oo-hero__ring { transform: none; opacity: .34; }
  }
</style>
