    it: '/it/diario/che-cos-e-octave-on/',
    es: '/es/diario/que-es-octave-on/',
  },
  type: 'article',
  publishedTime: t.publishedTime,
  modifiedTime: t.modifiedTime,
  section: 'Mindful culture',
  tags: ['mindful events', 'conscious celebration', 'immersive experiences', 'Mediterranean events'],
  keywords: ['mindful events Altea', 'conscious events Costa Blanca', 'immersive music and art', 'alcohol-free events Spain', 'Mediterranean experiences'],
