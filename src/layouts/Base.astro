---
import '../styles/tokens.css';
import '../styles/global.css';
import { content, locales, homeHref, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
  seo?: SeoOverrides;
}
export interface SeoOverrides {
  title: string;
  description: string;
  ogAlt: string;
  canonicalPath?: string;
  alternatePaths?: Partial<Record<Lang, string>>;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  tags?: string[];
  keywords?: readonly string[];
}

const { lang, seo } = Astro.props;
const t = content[lang];
const meta: SeoOverrides = { ...t.meta, ...(seo ?? {}) };
const canonical = new URL(meta.canonicalPath ?? homeHref(lang), Astro.site).toString();
const alternates = locales.map((locale) => ({
  locale,
  href: new URL(meta.alternatePaths?.[locale] ?? homeHref(locale), Astro.site).toString(),
}));
const ogLocales: Record<Lang, string> = { en: 'en_GB', it: 'it_IT', es: 'es_ES' };
const ogImage = new URL(meta.image ?? '/brand/octave-on-logo.png', Astro.site).toString();
const ogImageType = meta.image?.endsWith('.png') ? 'image/png' : meta.image ? 'image/webp' : 'image/png';
const ogImageWidth = meta.image ? 1672 : 1064;
const ogImageHeight = meta.image ? 937 : 671;
const siteUrl = (Astro.site ?? new URL('https://octaveon.octaveon185.workers.dev')).toString().replace(/\/$/, '');
const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Octave On',
      url: `${siteUrl}/`,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}/brand/octave-on-logo.png`,
        width: 1064,
        height: 671,
      },
      description: meta.description,
      areaServed: [
        {
          '@type': 'Place',
          name: 'Altea, Costa Blanca, Spain',
          address: {
            '@type': 'PostalAddress',
            addressLocality: 'Altea',
            addressRegion: 'Alicante',
            addressCountry: 'ES',
          },
        },
        { '@type': 'Place', name: 'Mediterranean' },
      ],
      knowsAbout: [
        'mindful events',
        'conscious celebration',
        'immersive music and visual art',
        'botanical elixirs',
        'Mediterranean cultural experiences',
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'invitations',
        url: `${siteUrl}${homeHref(lang)}#invito`,
        availableLanguage: ['en', 'it', 'es'],
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'Octave On',
      url: `${siteUrl}/`,
      publisher: { '@id': `${siteUrl}/#organization` },
      inLanguage: lang,
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: meta.title,
      description: meta.description,
      isPartOf: { '@id': `${siteUrl}/#website` },
      about: { '@id': `${siteUrl}/#organization` },
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImage },
      inLanguage: lang,
      ...(meta.keywords?.length ? { keywords: meta.keywords.join(', ') } : {}),
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="author" content="Octave On" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    {alternates.map(({ locale, href }) => (
      <link rel="alternate" hreflang={locale} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(meta.alternatePaths?.en ?? '/', Astro.site).toString()} />

    <link rel="icon" type="image/svg+xml" href="/brand/octave-on-symbol-copper.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" as="image" href="/brand/octave-on-logo.png" fetchpriority="high" />
    <link rel="preload" as="image" href="/media/hero/water-resonance-poster.webp" type="image/webp" fetchpriority="high" />
    <meta name="theme-color" content="#030824" />

    <!-- Open Graph / social -->
    <meta property="og:type" content={meta.type ?? 'website'} />
    <meta property="og:site_name" content="Octave On" />
    <meta property="og:locale" content={ogLocales[lang]} />
    {locales.filter((locale) => locale !== lang).map((locale) => (
      <meta property="og:locale:alternate" content={ogLocales[locale]} />
    ))}
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={meta.ogAlt} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={meta.ogAlt} />
    {meta.type === 'article' && meta.publishedTime && (
      <meta property="article:published_time" content={meta.publishedTime} />
    )}
    {meta.type === 'article' && meta.modifiedTime && (
      <meta property="article:modified_time" content={meta.modifiedTime} />
    )}
    {meta.type === 'article' && meta.section && <meta property="article:section" content={meta.section} />}
    {meta.type === 'article' && meta.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteSchema)} />

    <!-- Editorial display + clean interface type -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Manrope:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />

    <script>
      import Lenis from 'lenis';

      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        // Let Lenis own its single RAF loop. A second manual loop here made
        // scroll-heavy sections compete for the same frame budget.
        const lenis = new Lenis({ duration: 0.82, smoothWheel: true, autoRaf: true });

        // Smooth in-page anchor navigation (accounts for the fixed nav).
        document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
          a.addEventListener('click', (e) => {
            const id = a.getAttribute('href');
            if (!id || id === '#') return;
            const target = document.querySelector(id);
            if (!target) return;
            e.preventDefault();
            lenis.scrollTo(target as HTMLElement, { offset: -70 });
          });
        });

        // Expose for other scripts (e.g. the invite success scroll).
        (window as unknown as { lenis: Lenis }).lenis = lenis;
      }
    </script>
  </body>
</html>
